      "mainEntity": [
        {
          "@type": "Question",
          "name": "Вы працуеце толькі з Беларуссю?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Асноўны рэгіён практыкі — Беларусь, каманда знаходзіцца ў Мінску. Таксама працуем з кіраўнікамі і камандамі з Расіі. Фармат сумеснай працы ўзгадняем пад вашу задачу."
          }
        },
        {
          "@type": "Question",
          "name": "Гэта сапраўды бясплатна?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Так. Індывідуальныя кансультацыі і навучанне каманд адбываюцца без аплаты. Купляць прадукт або паслугі не патрабуецца."
          }
        },
        {
          "@type": "Question",
          "name": "Ці трэба ўжо быць CAIO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не. Дастаткова адказваць за AI-стратэгію, партфель ініцыятыў, укараненне або каардынацыю бізнесу і тэхналогій."
          }
        },
        {
          "@type": "Question",
          "name": "З чаго пачаць паведамленне?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Напішыце галіну, вашу ролю, бягучую сітуацыю і адно рашэнне, якое трэба прыняць. Выкарыстоўвайце абязлічаныя даныя."
          }
        },
        {
          "@type": "Question",
          "name": "Ці можна прыйсці ўсёй камандай?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Так. Асабліва карысна сабраць каманду з прадстаўнікоў бізнесу і IT, спецыялістаў па даных і бяспецы, юрыстаў і ўладальніка працэсу."
          }
        },
        {
          "@type": "Question",
          "name": "Ці будзе запіс або тыпавы курс?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Асноўны фармат — жывая праца з вашым кантэкстам. Матэрыялы і паслядоўнасць тэм падбіраюцца пад задачу."
          }
        }
      ]
